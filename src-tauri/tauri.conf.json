{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumi-AI Desktop",
  "version": "0.2.0",
  "identifier": "vn.lumiai.desktop",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:3039",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumi-AI Desktop",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ]
  }
}