{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/digital-learning/lesson.schema.json",
  "title": "Digital Learning Lesson",
  "description": "Canonical LMS-independent lesson design schema based on outcome-evidence-activity alignment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lesson", "outcomes", "evidence", "learning_units", "qa"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "lesson": {"$ref": "#/$defs/lessonMetadata"},
    "outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outcome"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "learning_units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/learningUnit"}},
    "final_assessment": {"oneOf": [{"$ref": "#/$defs/finalAssessment"}, {"type": "null"}]},
    "qa": {"$ref": "#/$defs/qaReport"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$", "minLength": 2, "maxLength": 100},
    "nonEmptyText": {"type": "string", "minLength": 1},
    "idList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "lessonMetadata": {"type": "object", "additionalProperties": false, "required": ["id", "title", "language", "status"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/nonEmptyText"}, "description": {"type": "string"}, "language": {"type": "string", "default": "vi"}, "subject": {"type": "string"}, "course": {"type": "string"}, "target_learners": {"type": "string"}, "estimated_duration_minutes": {"type": "integer", "minimum": 1}, "delivery_mode": {"type": "string", "enum": ["online", "face_to_face", "blended", "self_paced", "unspecified"], "default": "unspecified"}, "status": {"type": "string", "enum": ["draft", "outcomes_pending", "outcomes_locked", "design_ready", "published"]}
    }},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {
      "type": {"type": "string", "enum": ["source", "user_provided", "inferred", "ai_generated"]}, "document_id": {"type": ["string", "null"]}, "document_name": {"type": ["string", "null"]}, "location": {"type": ["string", "null"]}, "source_excerpt": {"type": ["string", "null"]}, "requires_verification": {"type": "boolean", "default": false}
    }, "allOf": [{"if": {"properties": {"type": {"const": "ai_generated"}}, "required": ["type"]}, "then": {"required": ["requires_verification"], "properties": {"requires_verification": {"const": true}}}}]},
    "outcome": {"type": "object", "additionalProperties": false, "required": ["id", "text", "source", "status"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/nonEmptyText"}, "source": {"type": "string", "enum": ["official", "user_provided", "ai_proposed"]}, "status": {"type": "string", "enum": ["pending_approval", "locked", "rejected"]}, "domain": {"type": "string", "enum": ["cognitive", "psychomotor", "affective_autonomy", "mixed", "unspecified"]}, "cognitive_process": {"type": ["string", "null"], "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create", null]}, "knowledge_dimension": {"type": ["string", "null"], "enum": ["factual", "conceptual", "procedural", "metacognitive", "mixed", null]}, "observable_action": {"type": "string"}, "conditions": {"type": "string"}, "performance_criteria": {"type": "string"}, "parent_outcomes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "analysis_notes": {"type": "string"}, "provenance": {"$ref": "#/$defs/provenance"}
    }},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "description", "supports_outcomes", "evidence_type"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "description": {"$ref": "#/$defs/nonEmptyText"}, "supports_outcomes": {"$ref": "#/$defs/idList"}, "evidence_type": {"type": "string", "enum": ["selected_response", "classification", "sequencing", "constructed_response", "problem_solution", "scenario_performance", "product", "demonstration", "observation", "project", "portfolio", "other"]}, "observable_behavior": {"type": "string"}, "success_criteria": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyText"}}, "assessment_required": {"type": "boolean", "default": true}
    }},
    "learningUnit": {"type": "object", "additionalProperties": false, "required": ["id", "title", "supports_outcomes", "activities"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/nonEmptyText"}, "description": {"type": "string"}, "supports_outcomes": {"$ref": "#/$defs/idList"}, "sequence": {"type": "integer", "minimum": 1}, "estimated_duration_minutes": {"type": "integer", "minimum": 1}, "activities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/activity"}}, "summary": {"type": "string"}
    }},
    "activity": {"type": "object", "additionalProperties": false, "required": ["id", "learning_type", "supports_outcomes", "instruction"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "title": {"type": "string"}, "learning_type": {"type": "string", "enum": ["acquisition", "investigation", "discussion", "practice", "collaboration", "production"]}, "supports_outcomes": {"$ref": "#/$defs/idList"}, "supports_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "instruction": {"$ref": "#/$defs/nonEmptyText"}, "estimated_duration_minutes": {"type": "integer", "minimum": 1}, "delivery": {"$ref": "#/$defs/delivery"}, "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}}, "assessment": {"oneOf": [{"$ref": "#/$defs/assessment"}, {"type": "null"}]}
    }},
    "delivery": {"type": "object", "additionalProperties": false, "properties": {"mode": {"type": "string", "enum": ["online", "face_to_face", "blended", "unspecified"]}, "synchronous": {"type": "boolean"}, "individual_or_group": {"type": "string", "enum": ["individual", "group", "either"]}, "group_size": {"type": ["integer", "null"], "minimum": 2}, "teacher_presence": {"type": "string", "enum": ["required", "optional", "not_required", "unspecified"]}, "external_platform_required": {"type": "boolean", "default": false}}},
    "resource": {"type": "object", "additionalProperties": false, "required": ["id", "type", "content_role", "purpose", "supports_outcomes", "provenance"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "type": {"type": "string", "enum": ["text", "image", "annotated_image", "diagram", "table", "comparison", "flowchart", "timeline", "infographic", "audio", "video", "animation", "simulation", "3d_model", "document", "external_link", "other"]}, "content_role": {"type": "string", "enum": ["essential", "supporting", "enrichment"]}, "purpose": {"$ref": "#/$defs/nonEmptyText"}, "supports_outcomes": {"$ref": "#/$defs/idList"}, "content": {"type": "string"}, "media_spec": {"oneOf": [{"$ref": "#/$defs/mediaSpec"}, {"type": "null"}]}, "accessibility": {"$ref": "#/$defs/accessibility"}, "provenance": {"$ref": "#/$defs/provenance"}
    }},
    "mediaSpec": {"type": "object", "additionalProperties": false, "properties": {"description": {"type": "string"}, "generation_prompt": {"type": "string"}, "required_elements": {"type": "array", "items": {"type": "string"}}, "avoid_elements": {"type": "array", "items": {"type": "string"}}}},
    "assessment": {"type": "object", "additionalProperties": false, "required": ["id", "purpose", "supports_outcomes", "measures_evidence", "assessment_function"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "purpose": {"type": "string", "enum": ["diagnostic", "formative", "summative"]}, "supports_outcomes": {"$ref": "#/$defs/idList"}, "measures_evidence": {"$ref": "#/$defs/idList"}, "assessment_function": {"type": "string", "enum": ["identify", "recall", "explain", "classify", "compare", "sequence", "apply", "analyze", "evaluate", "construct", "perform", "reflect", "other"]}, "interaction_preference": {"type": ["string", "null"], "enum": ["multiple_choice", "multiple_response", "true_false", "fill_blank", "mark_words", "matching", "sorting", "drag_drop", "short_answer", "essay", "scenario", "performance_task", "external", null]}, "instructions": {"type": "string"}, "items": {"type": "array", "items": {"$ref": "#/$defs/assessmentItem"}}, "feedback": {"$ref": "#/$defs/feedback"}, "scoring": {"$ref": "#/$defs/scoring"}
    }},
    "assessmentItem": {"type": "object", "additionalProperties": false, "required": ["id", "prompt"], "properties": {"id": {"$ref": "#/$defs/id"}, "prompt": {"$ref": "#/$defs/nonEmptyText"}, "options": {"type": "array", "items": {"$ref": "#/$defs/answerOption"}}, "expected_response": {}, "rationale": {"type": "string"}}},
    "answerOption": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"$ref": "#/$defs/nonEmptyText"}, "correct": {"type": "boolean"}, "feedback": {"type": "string"}}},
    "feedback": {"type": "object", "additionalProperties": false, "properties": {"mode": {"type": "string", "enum": ["immediate", "delayed", "teacher", "peer", "self", "mixed"]}, "correct": {"type": "string"}, "incorrect": {"type": "string"}, "explanation": {"type": "string"}, "review_resources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "allow_retry": {"type": "boolean"}}},
    "scoring": {"type": "object", "additionalProperties": false, "properties": {"max_score": {"type": "number", "minimum": 0}, "passing_score": {"type": "number", "minimum": 0}, "contributes_to_final": {"type": "boolean"}}},
    "finalAssessment": {"type": "object", "additionalProperties": false, "required": ["supports_outcomes", "assessments"], "properties": {"supports_outcomes": {"$ref": "#/$defs/idList"}, "assessments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assessment"}}}},
    "accessibility": {"type": "object", "additionalProperties": false, "properties": {"alt_text": {"type": ["string", "null"]}, "long_description": {"type": ["string", "null"]}, "caption_available": {"type": ["boolean", "null"]}, "transcript_available": {"type": ["boolean", "null"]}, "keyboard_access_required": {"type": ["boolean", "null"]}, "color_independent": {"type": ["boolean", "null"]}, "notes": {"type": "string"}}},
    "qaReport": {"type": "object", "additionalProperties": false, "required": ["status", "checks"], "properties": {"status": {"type": "string", "enum": ["not_run", "pass", "warn", "fail", "block"]}, "design_ready": {"type": "boolean", "default": false}, "checks": {"type": "array", "items": {"$ref": "#/$defs/qaCheck"}}}},
    "qaCheck": {"type": "object", "additionalProperties": false, "required": ["rule_id", "status", "message"], "properties": {"rule_id": {"type": "string"}, "status": {"type": "string", "enum": ["pass", "warn", "fail", "block"]}, "message": {"$ref": "#/$defs/nonEmptyText"}, "affected_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "recommended_action": {"type": "string"}}}
  }
}